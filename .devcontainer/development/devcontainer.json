{
  "name": "Homelab - Development",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "development"
  },
  "init": true,
  "mounts": [
    "type=volume,source=homelab-development-${devcontainerId}-codex,target=/home/vscode/.codex",
    "type=volume,source=homelab-development-${devcontainerId}-uv-cache,target=/home/vscode/.cache/uv"
  ],
  "runArgs": [
    "--secret",
    "codex-github-pat,type=env,target=CODEX_GITHUB_PAT"
  ],
  "features": {
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/nix:1": {}
  },
  "remoteUser": "vscode",
  "onCreateCommand": "sudo chown \"$(id -u):$(id -g)\" /home/vscode/.codex /home/vscode/.cache/uv",
  "postCreateCommand": [
    "codex", "mcp", "add", "github",
    "--url", "https://api.githubcopilot.com/mcp/readonly",
    "--bearer-token-env-var", "CODEX_GITHUB_PAT"
  ]
}
